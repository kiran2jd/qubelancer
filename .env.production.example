# =============================================================================
# QUBELANCER PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================

# Server Domain & ACME (Let's Encrypt SSL)
DOMAIN_NAME=qubelancer.com
ACME_EMAIL=admin@qubelancer.com

# Core Application Settings
PROJECT_NAME="QubeLancer"
DEBUG=False
DOMAIN=qubelancer.com

# Security & JWT Authentication (Generate using: openssl rand -hex 32)
SECRET_KEY=change-this-to-a-very-strong-64-character-random-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS Origins (Include both naked and www domains)
BACKEND_CORS_ORIGINS=["https://qubelancer.com","https://www.qubelancer.com"]

# PostgreSQL Production Database Credentials
POSTGRES_USER=qubelancer_prod_user
POSTGRES_PASSWORD=generate_a_secure_postgres_password_here
POSTGRES_DB=qubelancer_prod

# Razorpay Production / Test API Credentials
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_actual_webhook_secret

# Object Storage / S3 / Cloud Bucket (Optional)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=qubelancer-documents-prod
S3_REGION=us-east-1

# Email Notifications (SMTP / Postmark / SendGrid)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
EMAILS_FROM_EMAIL=notifications@qubelancer.com
EMAILS_FROM_NAME="QubeLancer Platform"
